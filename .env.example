# ---------------------------------------------------------------------------
# GHL Sales Call Tracking Dashboard — environment variables
# Copy to .env.local for development. In production set these in
# Vercel → Project → Settings → Environment Variables. NEVER commit real values.
# With no Supabase values set, the app runs on clearly-labelled DEMO data.
# ---------------------------------------------------------------------------

# Public URL of this deployment (used for OAuth redirect + webhook URL)
APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — used solely by webhooks and sync jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: force "mock" or "supabase" (default: supabase when URL+anon key are set)
# DATA_SOURCE=

# --- Security --------------------------------------------------------------
# 32 random bytes, base64. Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate: openssl rand -hex 32
CRON_SECRET=

# --- GoHighLevel OAuth marketplace app (recommended; required for webhooks) --
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Space-separated. Defaults to the read-only set below if unset.
# GHL_OAUTH_SCOPES=locations.readonly users.readonly contacts.readonly opportunities.readonly calendars.readonly calendars/events.readonly conversations/message.readonly payments/transactions.readonly

# Webhook signature key. Defaults to the key published in GHL's docs; set only
# if GHL announces a rotation. Paste PEM with literal \n for newlines.
# GHL_WEBHOOK_PUBLIC_KEY=
# Reject webhooks whose timestamp is older than this (seconds)
# GHL_WEBHOOK_MAX_AGE_SECONDS=300

# Sync collected revenue from GHL Payments transactions (needs payments/transactions.readonly)
GHL_SYNC_PAYMENTS=false

# --- Private Integration tokens (alternative to OAuth; polling only) --------
# One per sub-account. The NAME is entered on the Integrations page; the value
# lives only here. Names must start with GHL_PIT_.
# GHL_PIT_ACCOUNT_1=
# GHL_PIT_ACCOUNT_2=
# GHL_PIT_ACCOUNT_3=
# GHL_PIT_ACCOUNT_4=

# --- Display / reporting ---------------------------------------------------
# Default reporting timezone until changed in Settings (IANA name)
REPORTING_TIMEZONE=Australia/Sydney
NEXT_PUBLIC_CURRENCY=AUD
